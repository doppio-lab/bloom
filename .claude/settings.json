{
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(scripts/ui-demo.sh:*)",
      "Bash(mise tasks:*)",
      "Bash(mise run test)",
      "Bash(mise run check)",
      "Bash(mise run demo)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(curl localhost:*)",
      "Bash(curl -s localhost:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./restic.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-ui-rules.sh" }
        ]
      }
    ]
  }
}
