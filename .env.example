# Copier en .env. Ne jamais commiter le .env.

# Sécurité : tant que DRY_RUN=true, aucun email ne part (ils sont écrits dans les logs).
DRY_RUN=true

ADMIN_PASSWORD=change-me
UNSUBSCRIBE_SECRET=une-longue-chaine-aleatoire
PUBLIC_BASE_URL=https://prospect.example.fr

DB_USER=bloom
DB_PASSWORD=bloom

ANTHROPIC_API_KEY=sk-ant-...

# Optionnel : API Offres d'emploi France Travail (francetravail.io, gratuit)
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Optionnel : email professionnel vérifié à partir du nom (payant, developer.dropcontact.com)
DROPCONTACT_API_KEY=

# Découverte automatique (chaque nuit à 2h)
DISCOVERY_APPS_PER_RUN=120
# Entreprises à ne jamais prospecter : clients actuels, partenaires, séparées par des virgules
DISCOVERY_EXCLUDE=Decathlon,Crédit Agricole,Proton,Netatmo,Happn,Routine,Cogepart,Music Work,PlayGuide,UFC Que Choisir

# Boîtes d'envoi sur un domaine secondaire (jamais doppio-lab.com).
# Format : adresse:mot-de-passe-d-application:Nom affiché, séparées par des virgules.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
MAILBOXES=prenom@doppio-studio.fr:xxxx xxxx xxxx xxxx:Prénom Nom
MAX_PER_MAILBOX_PER_DAY=25

SENDER_NAME=Prénom, cofondateur de Doppio Lab
LEGAL_FOOTER_FR=Doppio Lab (Advisely), Paris. Vos coordonnées professionnelles proviennent de sources publiques (site de votre entreprise, annuaire des entreprises) et ne servent qu'à ce contact.
