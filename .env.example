# Copier en .env. Ne jamais commiter le .env.

# Sécurité : tant que DRY_RUN=true, aucun email ne part (ils sont écrits dans les logs).
DRY_RUN=true

ADMIN_PASSWORD=change-me
UNSUBSCRIBE_SECRET=une-longue-chaine-aleatoire
# Base des liens de désinscription. En production : l'URL publique du serveur.
PUBLIC_BASE_URL=http://localhost:8080

DB_USER=bloom
DB_PASSWORD=bloom

# Fournisseur de LLM : ollama (local, gratuit), anthropic (payant, qualité de production) ou openai
# (OpenAI et tout serveur compatible : LM Studio, llama.cpp, OpenRouter, Mistral).
LLM_PROVIDER=ollama

# Modèle principal (recherche, rédaction, coach) et modèle rapide (classification des réponses).
# Vides : mistral-small3.2 pour ollama, Sonnet et Haiku pour anthropic. Obligatoire pour openai.
LLM_MODEL=
LLM_MODEL_FAST=
# Fenêtre de contexte demandée au modèle local, en tokens
LLM_CONTEXT_LENGTH=16384

# ollama : installer Ollama puis "ollama pull mistral-small3.2". Rien d'autre à renseigner.
# Avec docker compose, l'adresse est remplacée par celle de la machine hôte.
OLLAMA_BASE_URL=http://localhost:11434

# anthropic
ANTHROPIC_API_KEY=

# openai. Pour un serveur local, donner sa racine sans /v1, par exemple http://localhost:1234 (LM Studio).
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optionnel : API Offres d'emploi France Travail (francetravail.io, gratuit)
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Optionnel : email professionnel vérifié à partir du nom (payant, developer.dropcontact.com)
DROPCONTACT_API_KEY=

# Découverte automatique (chaque nuit à 2h)
# Sources de découverte actives, séparées par des virgules. Toutes sont publiques et sans clé :
#   bodacc    : augmentations de capital (annonces légales), signal de levée de fonds
#   boamp     : appels d'offres publics qui demandent une application mobile
#   github    : organisations françaises qui publient du code Kotlin Multiplatform
#   jobboards : pages carrières Greenhouse, Lever et Ashby des comptes déjà connus
#   press     : titres de levées de fonds (flux RSS FrenchWeb et Maddyness). Désactivée par défaut :
#               vérifier les conditions de réutilisation des deux flux avant de l'ajouter à la liste.
# Les classements App Store tournent toujours ; les offres d'emploi France Travail dès que FT_CLIENT_ID est renseigné.
DISCOVERY_SOURCES=bodacc,boamp,github,jobboards
# Capital minimal (en euros, après augmentation) pour qu'une annonce BODACC soit étudiée
BODACC_MIN_CAPITAL=100000
# Optionnel : jeton GitHub sans aucune permission, pour passer de 10 à 30 recherches par minute
GITHUB_TOKEN=
DISCOVERY_APPS_PER_RUN=120
# Entreprises à ne jamais prospecter : clients actuels, partenaires, séparées par des virgules
DISCOVERY_EXCLUDE="Decathlon,Crédit Agricole,Proton,Netatmo,Happn,Routine,Cogepart,Music Work,PlayGuide,UFC Que Choisir"

# Boîtes d'envoi sur un domaine secondaire (jamais doppio-lab.com).
# Format : adresse:mot-de-passe-d-application:Nom affiché, séparées par des virgules.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
MAILBOXES="prenom@doppio-studio.fr:xxxx xxxx xxxx xxxx:Prénom Nom"
MAX_PER_MAILBOX_PER_DAY=25

SENDER_NAME="Prénom, cofondateur de Doppio Lab"
LEGAL_FOOTER_FR="Doppio Lab (Advisely), Paris. Vos coordonnées professionnelles proviennent de sources publiques (site de votre entreprise, annuaire des entreprises) et ne servent qu'à ce contact."
