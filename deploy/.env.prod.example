# Copier en /opt/bloom/.env sur le serveur (chmod 600). Ne jamais commiter le .env.
# Chaque secret : openssl rand -hex 32. Le serveur refuse de démarrer avec une valeur vide, une valeur
# d'exemple ou un secret de moins de 16 caractères.

# Image déployée (sha du commit sur main). deploy.sh la met à jour.
BLOOM_TAG=latest
# Nom public servi par Caddy : seuls /u/... (désinscription) et /health y répondent
PUBLIC_HOST=bloom.doppio-studio.fr
PUBLIC_BASE_URL=https://bloom.doppio-studio.fr

# Phase 1 : aucun email ne part. Ne passer à false qu'après la phase 2 du README.
DRY_RUN=true

ADMIN_PASSWORD=
UNSUBSCRIBE_SECRET=
DB_USER=bloom
DB_PASSWORD=

# Pas de GPU sur le VPS : Anthropic, plafonné par jour
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=
LLM_MODEL_FAST=
LLM_DAILY_TOKEN_BUDGET=2000000

LOG_LEVEL=INFO

FT_CLIENT_ID=
FT_CLIENT_SECRET=
DROPCONTACT_API_KEY=
GITHUB_TOKEN=

DISCOVERY_SOURCES=bodacc,boamp,ted,decp,codeur,press,github,jobboards
BODACC_MIN_CAPITAL=100000
DECP_RENEWAL_MONTHS=12
CODEUR_MIN_BUDGET=1000
DISCOVERY_APPS_PER_RUN=400
DISCOVERY_EXCLUDE="Decathlon,Crédit Agricole,Proton,Netatmo,Happn,Routine,Cogepart,Music Work,PlayGuide,UFC Que Choisir"

# Boîtes d'envoi : laisser vide en phase 1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
MAILBOXES=
MAX_PER_MAILBOX_PER_DAY=25

SENDER_NAME="Prénom, cofondateur de Doppio Lab"
LEGAL_FOOTER_FR="Doppio Lab (Advisely), Paris. Vos coordonnées professionnelles proviennent de sources publiques (site de votre entreprise, annuaire des entreprises) et ne servent qu'à ce contact."
LEGAL_FOOTER_EN="Doppio Lab (Advisely), Paris. Your business contact details come from public sources (your company website, the company registry) and are only used for this contact."
