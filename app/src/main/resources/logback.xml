<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <!-- Line breaks are stripped from messages: a crafted subject or address cannot forge a log line -->
        <encoder><pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %replace(%msg){'[\r\n]+', ' '}%n</pattern></encoder>
    </appender>
    <!-- LOG_LEVEL=DEBUG to see Bloom's own debug output -->
    <logger name="lab.doppio" level="${LOG_LEVEL:-INFO}"/>
    <logger name="bloom" level="${LOG_LEVEL:-INFO}"/>
    <!-- Libraries stay quiet unless something goes wrong -->
    <logger name="io.netty" level="WARN"/>
    <logger name="io.ktor" level="INFO"/>
    <logger name="org.flywaydb" level="INFO"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="Exposed" level="WARN"/>
    <logger name="ai.koog" level="WARN"/>
    <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
